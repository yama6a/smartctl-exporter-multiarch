{
  // The shared preset holds the grouping, automerge and digest rules. The cron in the renovate workflow sets
  // the cadence. A merged bump to versions.env rebuilds the image. CI does not build the image, so a bad bump
  // shows up as a failed build workflow on main.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>yama6a/gha:default.json5"],

  prConcurrentLimit: 6,

  customManagers: [
    {
      // No built-in manager reads versions.env. Captures tag and digest from the ref, so both stay current.
      customType: "regex",
      description: "docker image refs (annotated) in versions.env",
      managerFilePatterns: ["/^versions\\.env$/"],
      matchStrings: [
        "# renovate: datasource=docker(?: versioning=(?<versioning>\\S+))?\\s+[^\\n]*?(?<depName>[a-z0-9][a-z0-9._/-]+):(?<currentValue>[\\w][\\w.-]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?",
      ],
      datasourceTemplate: "docker",
    },
    {
      // Scalar vars in versions.env carrying a full `# renovate:` annotation.
      customType: "regex",
      description: "annotated version scalars in versions.env",
      managerFilePatterns: ["/^versions\\.env$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+\\w+=\"(?<currentValue>[^\"]+)\"",
      ],
    },
  ],

  packageRules: [
    {
      // A minor or major upstream release can rename the assets, move the binary or change the chart's flags.
      description: "smartctl_exporter minor and major: reviewed alone",
      matchDepNames: ["prometheus-community/smartctl_exporter"],
      matchUpdateTypes: ["major", "minor"],
      groupName: null, // in the combined group, it would block that PR's automerge
      automerge: false,
      addLabels: ["needs-review"],
    },
  ],
}
