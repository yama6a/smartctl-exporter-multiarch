# Both pins feed the build fingerprint, so a merged change to either one releases a new build revision.

# The upstream release whose binary this image packages. Its tag is also the prefix of this repo's tags.
# renovate: datasource=github-releases depName=prometheus-community/smartctl_exporter
SMARTCTL_EXPORTER_VERSION="v0.14.0"

# Supplies smartctl, which the exporter runs. A bump changes what the image ships, so it releases too.
# renovate: datasource=docker
ALPINE_IMAGE="alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6"
